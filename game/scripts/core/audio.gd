extends Node
## Sound (autoload "Audio"). Settings in res://data/audio.json; the sounds are generated by tools/audio/.
##   Audio.play("jump")          one-shot effect (game/assets/audio/sfx/jump.wav)
##   Audio.music("level")        loops the song set for "level" in audio.json (or a song file name)
##   Audio.stop_music()

const SFX_DIR := "res://assets/audio/sfx/"
const MUSIC_DIR := "res://assets/audio/music/"
const VOICES := 14

var cfg: Dictionary
var _voices: Array[AudioStreamPlayer] = []
var _next := 0
var _cache := {}
var _last_played := {}      ## name -> msec, so the same sound can't stack many times in one frame
var _music_player: AudioStreamPlayer
var _song := ""

func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	cfg = Game.load_json("res://data/audio.json")
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		add_child(p)
		_voices.append(p)
	_music_player = AudioStreamPlayer.new()
	add_child(_music_player)

func _stream(path: String) -> AudioStream:
	if not _cache.has(path):
		_cache[path] = load(path) if ResourceLoader.exists(path) else null
	return _cache[path]

func play(name: String) -> void:
	if name == "":
		return
	var now := Time.get_ticks_msec()
	if now - int(_last_played.get(name, -1000)) < 40:
		return
	_last_played[name] = now
	var stream := _stream(SFX_DIR + name + ".wav")
	if stream == null:
		push_warning("No sound " + name)
		return
	var s: Dictionary = cfg.get("sfx", {}).get(name, {})
	# use a free voice, or steal the oldest one
	var p: AudioStreamPlayer = null
	for i in VOICES:
		var v := _voices[(_next + i) % VOICES]
		if not v.playing:
			p = v
			break
	if p == null:
		p = _voices[_next]
	_next = (_next + 1) % VOICES
	p.stream = stream
	p.volume_db = cfg.get("sfx_db", 0.0) + s.get("db", 0.0)
	var vary: float = s.get("pitch", 0.0)
	p.pitch_scale = 1.0 + randf_range(-vary, vary)
	p.play()

func music(what: String) -> void:
	var song: String = cfg.get("music", {}).get(what, what)
	if song == _song and _music_player.playing:
		return
	_song = song
	var stream := _stream(MUSIC_DIR + song + ".wav") as AudioStreamWAV
	if stream == null:
		_music_player.stop()
		return
	stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
	stream.loop_begin = 0
	stream.loop_end = int(stream.get_length() * stream.mix_rate)
	_music_player.stream = stream
	_music_player.volume_db = cfg.get("music_db", -8.0)
	_music_player.play()

func stop_music() -> void:
	_song = ""
	_music_player.stop()
