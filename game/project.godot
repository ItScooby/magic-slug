; Engine configuration file.
; Controls (keyboard + PS5 DualSense) are set up in code: scripts/core/controls.gd

config_version=5

[application]

config/name="Magic Slug"
config/description="Run-and-gun com magia: mago e arqueiro contra zumbis em masmorras e templos."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

Game="*res://scripts/core/game.gd"
Sheets="*res://scripts/core/sheets.gd"
Fx="*res://scripts/core/fx.gd"
Audio="*res://scripts/core/audio.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0

[physics]

2d/default_gravity=900.0

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
